# Prime Exchanges Account Management — Environment Variables
#
# Copy this file to `.env` (local dev) or `.env.production` (build) and
# adjust the values. Never commit real secrets to the repository.

# Base URL for the portal API server.
#
# Leave UNSET during local prototyping to use the built-in mock-data fallback.
# In production, set this to the API root served by the ASP.NET Core portal
# application (e.g. https://accounts.primexchanges.com/api).
#
# Per MONSTERASP_INTEGRATION.md, serving /api from the same origin as the
# compiled React files is preferred to avoid CORS complexity.
#
# Local ASP.NET Core backend (HTTPS — recommended):
#   dotnet dev-certs https --trust
# VITE_API_BASE_URL=https://localhost:5001/api
#
# Local ASP.NET Core backend (HTTP):
# VITE_API_BASE_URL=http://localhost:5000/api
#
# Production example:
# VITE_API_BASE_URL=https://accounts.primexchanges.com/api

# Enable demo client/admin portal routes for visual development.
# Keep false or unset for every deployed build. This switch is only for visual
# review of synthetic client/admin screens during local development.
VITE_ENABLE_DEMO_PORTALS=false

# Never put passwords, database strings, API secrets, PDF tokens or real data
# in a VITE_* variable: Vite exposes those values to the browser bundle.
